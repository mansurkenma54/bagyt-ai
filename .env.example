# Optional Neon PostgreSQL connection. Server only; never commit real credentials.
DATABASE_URL=
# No external account is required for the local PostgreSQL database.
BAGYT_DATA_DIR=./data/postgres
# Server-side only. Leave blank to use transparent rule-based analytics.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OCR downloads eng/rus language data to the OS temporary directory on first use.
OCR_LANGUAGES=eng+rus
# Use HTTPS and set this to true when deploying behind HTTPS.
COOKIE_SECURE=false

# Google Gemini: server-side only, preferred when configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
